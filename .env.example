PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:4200"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qatracker_db?schema=public"

# Authentication & JWT
JWT_SECRET="messysprint_jwt_secret_key_change_in_production"
JWT_ACCESS_SECRET="messysprint_access_token_secret"
JWT_REFRESH_SECRET="messysprint_refresh_token_secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
